# ============================================================
# ai_knowledge_base 根环境变量示例（复制为 .env 后填写）
# 用途：apps/server 与 apps/ai-service 共用，仅保留根目录这一份
# ============================================================

# ---- PostgreSQL（本地默认：postgres / postgres@localhost:5432）----
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=ai_knowledge_base

# ---- 鉴权（server 端使用）----
# 必须改为 32 位以上随机字符串，否则服务启动时会拒绝启动（fail-fast）
JWT_SECRET=please-change-me-to-a-long-random-string-at-least-32-chars
# 使用 openssl rand -hex 32 生成；server 与 ai-service 必须使用同一把密钥
ENV_ENCRYPTION_KEY=replace-with-64-hex-characters-from-openssl-rand-hex-32
JWT_EXPIRES_IN=7d

# ---- ai-service 内部共享密钥（server → ai-service 请求头 X-Internal-Token）----
# 同样要求 32 位以上随机字符串；server 与 ai-service 必须配置一致
INTERNAL_AI_TOKEN=please-change-me-to-another-long-random-string-32-chars

# ---- 服务端口 ----
SERVER_PORT=3000
AI_SERVICE_PORT=3001
# ai-service 只监听 127.0.0.1，这里保持内网地址即可
AI_SERVICE_URL=http://127.0.0.1:3001

# ---- OpenAI 兼容模型默认配置（设置页回显默认值；可按需填写）----
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002
OPENAI_CHAT_MODEL=gpt-4o-mini

# ---- 检索/生成参数默认值（可选）----
AI_TEMPERATURE=0
AI_TOP_K=8
AI_KEYWORD_TOP_K=8
AI_MIN_SCORE=0.3
AI_RERANK_TOP_N=5
# 精确模型 ID 对应 USD/百万 Token 单价；按自己的供应商/网关价格维护，未配置的模型不估算费用。
AI_MODEL_PRICING={"gpt-4o-mini":{"inputUsdPerMillion":0.15,"outputUsdPerMillion":0.6},"text-embedding-ada-002":{"inputUsdPerMillion":0.1,"outputUsdPerMillion":0}}
