{
  "name": "ai-knowledge-base",
  "version": "1.0.0",
  "private": true,
  "description": "AI knowledge base monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/**\" --if-present dev",
    "build": "pnpm --recursive --if-present build",
    "test": "pnpm --recursive --if-present test"
  },
  "dependencies": {
    "iconv-lite": "^0.7.3",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.2",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
  }
}
