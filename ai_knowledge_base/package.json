{
  "name": "ai-knowledge-base",
  "version": "1.0.0",
  "private": true,
  "description": "AI knowledge base monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/**\" --if-present dev",
    "build": "pnpm --recursive --if-present build"
  }
}
